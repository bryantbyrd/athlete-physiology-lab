# Example configuration for scripts/sleep_import.
#
# Copy this file to
#   ~/.config/athlete-physiology-lab/sleep_import.env
# (or to any path named by $SLEEP_IMPORT_CONFIG) and fill in your own values.
# The real file holds a device identifier and personal paths: keep it out of
# version control. Everything in config/ except *.example is git-ignored.

# Folder that contains the "Archive" and "Current Night" folders.
SLEEP_BASE_DIR="/path/to/Sleep"

# 8-character sensor ID printed on the Polar H10 (also shown in the archive
# name: SF_<date>-<time>_Polar-H10-<ID>.zip).
POLAR_DEVICE_ID="XXXXXXXX"

# Optional: override the default sub-folders.
# SLEEP_ARCHIVE_DIR="$SLEEP_BASE_DIR/Archive"
# SLEEP_CURRENT_DIR="$SLEEP_BASE_DIR/Current Night"

# Optional, WSL only: mount a Windows drive (for example a cloud-sync drive)
# if it is not already mounted. Requires sudo.
# SLEEP_DRVFS_DRIVE="G:"
# SLEEP_DRVFS_MOUNT="/mnt/g"
